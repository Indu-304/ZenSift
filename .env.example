# Copy to .env and fill in real values. Never commit .env.

# Google Gemini (used via langchain-google-genai)
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Resend email delivery (sender is onboarding@resend.dev in testing mode, which
# can only deliver to the address you signed up to Resend with)
RESEND_API_KEY=
DIGEST_TO_EMAIL=you@example.com

# Local persistence
ZENSIFT_DB_PATH=data/zensift.db

# LangSmith observability (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zensift
